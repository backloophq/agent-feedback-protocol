{
  "name": "@backloop/mcp",
  "version": "0.1.2",
  "description": "MCP binding for the Agent Feedback Protocol: a submit_feedback tool for any MCP server, and a standalone stdio server.",
  "license": "Apache-2.0",
  "homepage": "https://trybackloop.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backloophq/agent-feedback-protocol.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/backloophq/agent-feedback-protocol/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "backloop-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@backloop/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
