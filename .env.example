# Copy to .env. The demo scripts read it; the defaults work as-is.

# ── Reference collector (packages/collector) ────────────────────────────
# Listens on PORT (default 4700) and appends records to this file
COLLECTOR_DATA_FILE=data/feedback.jsonl
# Keys services use on POST /v1/records (comma-separated; unset = open)
COLLECTOR_INGEST_KEYS=dev-ingest-key

# ── Demo API (examples/acme-api) ────────────────────────────────────────
ACME_PORT=4610
# Where the API forwards feedback records: the collector above
BACKLOOP_URL=http://localhost:4700
BACKLOOP_INGEST_KEY=dev-ingest-key
ACCOUNT_HASH_SECRET=demo-secret

# ── Optional: a real Claude agent (pnpm demo:claude-agent) ──────────────
# ANTHROPIC_API_KEY=
